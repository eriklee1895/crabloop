+    let server = StubResponses::start(vec![fixture("text"), fixture("text")]);
+    let output = task_output(&mut crabloop(&dir, &server), "first\n\nsecond\n");
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
