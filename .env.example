# Default startup: cargo run, then enter a task. Existing environment variables win.
DEEPSEEK_API_KEY=
# CRABLOOP_PROVIDER=deepseek
# CRABLOOP_MODEL=deepseek-flash

# To explicitly use OpenAI or an OpenAI-compatible endpoint:
# CRABLOOP_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CRABLOOP_MODEL=gpt-6-luna
# CRABLOOP_API_URL can override the full endpoint for the selected provider.
