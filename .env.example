# v1: cargo run, enter one task, then exit. Startup cwd is the workspace.
# Current-directory .env is read as data; process environment wins.
DEEPSEEK_API_KEY=
# Default is deepseek; there is no automatic provider selection.
# CRABLOOP_PROVIDER=deepseek
# CRABLOOP_MODEL=deepseek-flash

# To explicitly use OpenAI or an OpenAI-compatible endpoint:
# CRABLOOP_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CRABLOOP_MODEL=gpt-6-luna
# CRABLOOP_API_URL can override the full endpoint for the selected provider.
